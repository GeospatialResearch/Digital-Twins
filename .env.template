# Copy this file and store it as ".env" and fill in the required environment variables.

POSTGRES_HOST=localhost
POSTGRES_PORT=5431
POSTGRES_DB=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

MESSAGE_BROKER_HOST=localhost

GEOSERVER_HOST=http://localhost
GEOSERVER_PORT=8088
GEOSERVER_ADMIN_NAME=admin
GEOSERVER_ADMIN_PASSWORD=geoserver

# Optional: CRS core processing runs in, e.g. EPSG:32759. Unset: derived from the area of interest, else EPSG:4326.
EDDIE_WORKING_CRS=4326

BACKEND_HOST=http://localhost
BACKEND_PORT=5000

WWW_PORT=3001
CESIUM_ACCESS_TOKEN=
# Optional: LINZ basemaps API key for the "LINZ Aerial" basemap. The default basemap is OpenStreetMap.
LINZ_BASEMAPS_API_KEY=
# Optional: comma-separated domains the Terria server may proxy, e.g. example.com,example.org. Unset: none.
# terriajs-server proxies every domain if its config is empty or has no allowProxyFor, so the entrypoint always
# writes the list.
TERRIA_ALLOW_PROXY_FOR=
# Optional: false stops serving the GeoServer workspaces in the Terria catalogue. Plugin groups are always served.
# EDDIE_AUTOSERVE_CATALOG=true

# The following variables are used only for local development and debugging.
# See the wiki for instuctions on how to use them. <https://github.com/GeospatialResearch/Digital-Twins/wiki/Running-the-code-in-development-environment>
DATA_DIR_GEOSERVER=U:/Research/FloodRiskResearch/DigitalTwin/stored_data/geoserver

# Optional: name of this deployment, shown in Swagger, WPS metadata and the Terria catalogue.
# EDDIE_INSTANCE_TITLE=Environmental Digital Data Intelligence Engine (EDDIE) Core
