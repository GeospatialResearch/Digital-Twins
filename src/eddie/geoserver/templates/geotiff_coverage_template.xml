<coverage>
    <!-- Template for a Geoserver Coverage file for a GeoTIFF layer. The CRS is read from the GeoTIFF itself. -->
    <name>{layer_name}</name>
    <nativeName>{layer_name}</nativeName>
    <title>{layer_name}</title>
    <nativeCRS>{native_crs}</nativeCRS>
    <srs>{native_crs}</srs>
    <supportedFormats>
        <string>GEOTIFF</string>
        <string>TIFF</string>
        <string>PNG</string>
    </supportedFormats>
    <dimensions>
        {coverage_dimensions_xml}
    </dimensions>
</coverage>